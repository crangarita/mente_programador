POSTGRES_DB=mente_programador
POSTGRES_USER=mente_programador_prod
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO

# Puertos expuestos en el host del VPS
BACKEND_PORT=8080
FRONTEND_PORT=80

# URL que usa el frontend para comunicarse con el backend (usado durante build del frontend)
# Ejemplo: https://api.tudominio.com/api o http://IP_DEL_VPS:8080/api
VITE_API_URL=http://localhost:8080/api

# Origen permitido para CORS en el backend
# Ejemplo: https://tudominio.com o http://IP_DEL_VPS
FRONTEND_ORIGIN=http://localhost

# Tag de la imagen (definido automáticamente por el pipeline de Jenkins)
IMAGE_TAG=latest
